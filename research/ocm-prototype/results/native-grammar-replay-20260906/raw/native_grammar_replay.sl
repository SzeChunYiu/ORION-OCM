(set-logic LIA)
(set-option :output sygus-sol-gterm)
(set-option :out "stderr")
(synth-fun mux_3 ((x Int) (y Int) (z Int)) Int ((A_Int_489 Int) (A_Bool_491 Bool)) ((A_Int_489 Int (x y z 1 0 (+ A_Int_489 A_Int_489) (- A_Int_489 A_Int_489) (ite A_Bool_491 A_Int_489 A_Int_489))) (A_Bool_491 Bool (true false (= A_Int_489 A_Int_489) (<= A_Int_489 A_Int_489) (not A_Bool_491) (and A_Bool_491 A_Bool_491) (or A_Bool_491 A_Bool_491)))))
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(constraint (>= (mux_3 x y z) x))
(constraint (>= (mux_3 x y z) y))
(constraint (>= (mux_3 x y z) z))
(constraint (or (= x (mux_3 x y z)) (or (= y (mux_3 x y z)) (= z (mux_3 x y z)))))
(check-synth)

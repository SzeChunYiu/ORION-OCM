(options-auto produce-models true :reason "produce assignments or sygus")
(options-auto theoryof-mode term :reason "logic")
(options-auto symmetry-breaker 0 :reason "logic and options")
(options-auto bv-propagate false :reason "bitblast solver")
(options-auto heuristic-pivots 5 :reason "logic")
(options-auto cegqi-midpoint true :reason "sygus")
(options-auto cegqi-bv false :reason "sygus")
(options-auto cegqi true :reason "sygusRepairConst")
(options-auto sygus-si use :reason "sygus")
(options-auto cbqi false :reason "sygus")
(options-auto inst-no-entail false :reason "sygus")
(options-auto cegqi-full true :reason "sygus")
(options-auto miniscope-quant off :reason "sygus")
(options-auto dt-share-sel true :reason "SyGuS")
(options-auto minisat-simplification clause-elim :reason "non-basic logic")
(options-auto arrays-optimize-linear false :reason "models")
(options-auto nl-cov false :reason "logic without reals, or involving integers or quantifiers")
(sygus-grammar mux_3 ((A_Int_489 Int) (A_Bool_491 Bool) )((A_Int_489 Int (x y z 1 0 (+ A_Int_489 A_Int_489) (- A_Int_489 A_Int_489) (ite A_Bool_491 A_Int_489 A_Int_489)))(A_Bool_491 Bool (true false (= A_Int_489 A_Int_489) (<= A_Int_489 A_Int_489) (not A_Bool_491) (and A_Bool_491 A_Bool_491) (or A_Bool_491 A_Bool_491)))))

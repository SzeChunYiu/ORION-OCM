(set-logic LIA)
(set-option :output sygus-sol-gterm)
(set-option :out stderr)
(define-fun fn_0 ((h0 Int) (h1 Int)) Int (ite (>= h0 h1) h0 h1))
(synth-fun mux_3 ((x Int) (y Int) (z Int)) Int ((OCM_I Int) (OCM_B Bool) (OCM_K Int) (GEN_fn_0 Int)) ((OCM_I Int (x y z GEN_fn_0)) (OCM_B Bool (true false (and OCM_B OCM_B) (or OCM_B OCM_B) (not OCM_B) (=> OCM_B OCM_B) (= OCM_I OCM_I) (< OCM_I OCM_I) (<= OCM_I OCM_I) (> OCM_I OCM_I) (>= OCM_I OCM_I))) (OCM_K Int ((Constant Int))) (GEN_fn_0 Int ((fn_0 OCM_I OCM_I)))))
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(constraint (>= (mux_3 x y z) x))
(constraint (>= (mux_3 x y z) y))
(constraint (>= (mux_3 x y z) z))
(constraint (or (= x (mux_3 x y z)) (or (= y (mux_3 x y z)) (= z (mux_3 x y z)))))
(check-synth)

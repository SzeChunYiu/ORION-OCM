  "forbidden_feature_tokens": [
    "transformer", "cnn", "rnn", "lstm", "gru", "mlp", "svm", "perceptron",
    "attention", "neuron", "convolution", "backprop", "backpropagation", "bayes",
    "random forest", "decision tree", "kernel machine", "finite state machine"
  ],
  "falsifier": "A predictor-visible descriptor that requires a family label, leaks an excluded identity field, changes under metadata reminting, or cannot represent one of the registered structural coordinate families.",

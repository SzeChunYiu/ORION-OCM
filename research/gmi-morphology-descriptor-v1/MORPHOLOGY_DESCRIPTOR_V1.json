      "required_fields": ["kind", "capacity", "precision", "persistence"]
    },
    {
      "id": "operator_structure",
      "semantics": "primitive transformation and composition structure",
      "required_fields": ["arity", "locality", "composition_depth", "nonlinear_stage_count"]
    },
    {
      "id": "control_routing",
      "semantics": "how information selects and routes transformations",
      "required_fields": ["conditional_branches", "routing_state_capacity", "fan_in", "fan_out"]
    },
    {
      "id": "update_channel",
      "semantics": "where and how retained state or parameters may change",
      "required_fields": ["mutable_fraction", "signal_scope", "update_frequency", "credit_path_length"]
    },
    {
      "id": "memory_organization",
      "semantics": "retention and retrieval organization",
      "required_fields": ["addressability", "retained_items", "retrieval_fanout", "write_persistence"]
    },
    {
      "id": "sharing_symmetry",
      "semantics": "reuse of one rule or parameter across obligation-equivalent positions",
      "required_fields": ["sharing_groups", "largest_group", "equivariance_constraints", "reuse_count"]
    },
    {
      "id": "communication_channel",
      "semantics": "information exchange with other adaptive agents",
      "required_fields": ["alphabet_capacity", "rounds", "recipient_count", "shared_side_information"]
    },
    {
      "id": "tool_channel",
      "semantics": "externally delegated proposal or action channel",
      "required_fields": ["tool_count", "routing_choices", "result_bandwidth", "state_externalization"]
    },
    {
      "id": "verification_path",
      "semantics": "internal or external checking before adoption",
      "required_fields": ["verified_fraction", "verification_depth", "latency", "false_adoption_guard"]
    },
    {
      "id": "resource_footprint",
      "semantics": "hard per-instance and retained resource commitments",
      "required_fields": ["compute_units", "memory_units", "communication_units", "verification_units"]
    },
    {
      "id": "development_law",
      "semantics": "which morphology coordinates may change across development",
      "required_fields": ["mutable_coordinate_count", "transition_depth", "heritable_fraction", "self_modification_guard"]

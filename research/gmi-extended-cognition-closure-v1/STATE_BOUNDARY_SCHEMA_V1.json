{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMI body-environment state boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_state",
    "environment_state",
    "observation_map",
    "action_map",
    "world_transition",
    "future_interventions",
    "resource_coordinates",
    "custody"
  ],
  "properties": {
    "agent_state": {"type": "string", "minLength": 1},
    "environment_state": {"type": "string", "minLength": 1},
    "observation_map": {"type": "string", "minLength": 1},
    "action_map": {"type": "string", "minLength": 1},
    "world_transition": {"type": "string", "minLength": 1},
    "future_interventions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resource_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["internal_bits", "external_bits", "read_ops", "write_ops", "world_ops", "latency", "energy"]}
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_owner", "environment_owner", "reset_authority"],
      "properties": {
        "agent_owner": {"type": "string", "minLength": 1},
        "environment_owner": {"type": "string", "minLength": 1},
        "reset_authority": {"type": "string", "minLength": 1}
      }
    }
  }
}

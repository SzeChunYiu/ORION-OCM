    "IB_1_formalisation": {
      "objective": "L_beta(T) = I(T;X) - beta*I(T;Y), minimised over the registered encoder family",
      "encoder_family": "all deterministic encoders, i.e. all Bell(8) = 4140 set partitions of the 8-atom support",
      "scope_restriction": "DETERMINISTIC encoders only -- this is the deterministic information bottleneck, not the stochastic-encoder IB",
      "stochastic_encoders_optimised": false,
      "arithmetic": "every entropy is an exact rational combination of prime logarithms; order is decided by an exact integer comparison; no logarithm is ever evaluated",

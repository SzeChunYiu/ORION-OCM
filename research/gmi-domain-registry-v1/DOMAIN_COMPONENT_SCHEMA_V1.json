{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion-ocm.invalid/schemas/gmi-domain-components-v1.json",
  "title": "GMI domain component schemas V1",
  "$defs": {
    "state_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mathematical_object", "semantic_state", "observable_interface", "equivalence", "size_coordinates", "serialization"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mathematical_object": {"type": "string", "minLength": 1},
        "semantic_state": {"type": "string", "minLength": 1},
        "observable_interface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "equivalence": {"type": "string", "minLength": 1},
        "size_coordinates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "serialization": {"type": "string", "minLength": 1}
      }
    },
    "native_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signature", "preconditions", "semantics", "state_effect", "determinism", "exactness", "cost_coordinates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "semantics": {"type": "string", "minLength": 1},
        "state_effect": {"enum": ["READ_ONLY", "LOCAL_MUTATION", "GLOBAL_MUTATION", "TOPOLOGY_MUTATION", "MESSAGE_MUTATION"]},
        "determinism": {"enum": ["DETERMINISTIC", "STOCHASTIC", "SET_VALUED"]},
        "exactness": {"enum": ["EXACT", "APPROXIMATE_DECLARED", "STATISTICAL_DECLARED"]},
        "cost_coordinates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "development_law": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signature", "evidence_access", "verifier_access", "mutable_components", "history_effect", "stochasticity", "cost_coordinates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1},
        "evidence_access": {"type": "array", "items": {"type": "string"}},
        "verifier_access": {"type": "array", "items": {"type": "string"}},
        "mutable_components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "history_effect": {"enum": ["NONE", "INFORMATION", "RECODE", "SKILL", "LAW", "MORPH"]},
        "stochasticity": {"enum": ["DETERMINISTIC", "STOCHASTIC", "SET_VALUED"]},
        "cost_coordinates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "burden_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantic_requirement", "overhead_requirement", "directionality", "accepted_for_domain_equivalence", "boundary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic_requirement": {"type": "string", "minLength": 1},
        "overhead_requirement": {"type": "string", "minLength": 1},
        "directionality": {"enum": ["BIDIRECTIONAL", "ONE_WAY_ONLY"]},
        "accepted_for_domain_equivalence": {"type": "boolean"},
        "boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}

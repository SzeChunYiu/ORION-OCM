{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite population-hereditary carrier v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["genotype_space", "multiplicity", "fitness", "selection", "mutation", "lineage", "resource_coordinates"],
  "properties": {
    "genotype_space": {"type": "array", "minItems": 1, "uniqueItems": true},
    "multiplicity": {"type": "object", "minProperties": 1},
    "fitness": {"type": "object", "minProperties": 1},
    "selection": {"type": "string", "minLength": 1},
    "mutation": {"type": "string", "minLength": 1},
    "lineage": {"type": "string", "minLength": 1},
    "resource_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["population_size", "genotype_bits", "fitness_evaluations", "failed_offspring", "generations", "communication", "lineage_bits"]}
    }
  }
}

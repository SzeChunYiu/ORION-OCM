      "warrant": {
        "kind": "INSTRUCTION"
      }
    },
    {
      "id": "rep:vertex_form",
      "type": "representation",
      "statement": "a*(x + b/(2*a))**2 - Delta/(4*a) = 0; transport from standard form by completing the square",

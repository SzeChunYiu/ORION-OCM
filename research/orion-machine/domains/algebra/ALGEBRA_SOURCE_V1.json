      "produces": [],
      "warrant": {
        "kind": "INSTRUCTION",
        "check": "expand(a*(x - r1)*(x - r2)) - (a*x**2 + b*x + c) == 0"
      }
    },
    {
      "id": "con:a_nonzero",
      "type": "constraint",

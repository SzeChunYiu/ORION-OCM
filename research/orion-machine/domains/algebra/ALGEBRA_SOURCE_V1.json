  "atoms": [
    {
      "id": "def:polynomial",
      "type": "definition",
      "statement": "a polynomial in x over Q is a finite sum sum_k c_k x**k with c_k in Q",
      "preconditions": [],
      "produces": [],
      "warrant": {
        "kind": "INSTRUCTION"
      }
    },

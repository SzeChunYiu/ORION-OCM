      ],
      "produces": [],
      "warrant": {
        "kind": "INSTRUCTION",
        "check": "simplify(p.subs(x, r)) == 0"
      }
    },
    {
      "id": "def:discriminant",
      "type": "definition",
      "statement": "Delta = b**2 - 4*a*c",
      "preconditions": [

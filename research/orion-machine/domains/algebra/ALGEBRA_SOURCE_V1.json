        "def:discriminant"
      ],
      "produces": [],
      "warrant": {
        "kind": "INSTRUCTION",
        "check": "expand(a*(x + b/(2*a))**2 - (b**2 - 4*a*c)/(4*a)) - (a*x**2 + b*x + c) == 0"
      }
    },
    {
      "id": "rep:factored_form",
      "type": "representation",
      "statement": "a*(x - r1)*(x - r2) = 0 when r1, r2 are the roots",

    {
      "stage": "D0",
      "description": "basic exact interaction"
    },
    {
      "stage": "D1",
      "description": "composition, failure and scope"
    },
    {
      "stage": "D2",
      "description": "planning and uncertainty"
    },
    {
      "stage": "D3",
      "description": "formal mathematics and controlled language"
    },
    {
      "stage": "D4",
      "description": "coding, tools and scientific investigation"
    },
    {
      "stage": "D5",
      "description": "metacognition and learning to learn"
    },
    {
      "stage": "D6",
      "description": "governed self-evolution"
    }
  ],
  "required_arms": {
    "CONTINUED_OCM": "full earned prior developmental state",
    "RESET_OCM": "same immutable architecture and current-stage information, no prior competence",
    "STRONG_ADAPTIVE_PARENT": "strongest faithful parent with matched information, memory, tools and adaptation permissions",
    "TASK_SPECIFIC_OCM": "built for this stage alone; bounds how much of any gain is generality"
  },

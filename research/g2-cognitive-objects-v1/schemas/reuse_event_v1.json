{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion-ocm.local/schema/g2/reuse_event_v1.json",
  "title": "ReuseEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "method_ids",
    "task_id",
    "source_schema",
    "invocation_witness_id",
    "resources",
    "correctness",
    "usefulness",
    "authorization",
    "g24",
    "notes"
  ],
  "properties": {
    "schema": {"type": "string", "const": "ocm.g2.reuse-event.v1"},
    "event_id": {"$ref": "common.json#/$defs/nonempty_string"},
    "method_ids": {"type": "array", "items": {"$ref": "common.json#/$defs/unknownable_id"}, "minItems": 1, "uniqueItems": true},
    "task_id": {"$ref": "common.json#/$defs/unknownable_id"},
    "source_schema": {"$ref": "common.json#/$defs/unknownable_id"},
    "invocation_witness_id": {"$ref": "common.json#/$defs/unknownable_id"},
    "resources": {"$ref": "common.json#/$defs/resource_vector"},
    "correctness": {"$ref": "common.json#/$defs/correctness_evidence"},
    "usefulness": {"$ref": "common.json#/$defs/usefulness_evidence"},
    "authorization": {"$ref": "common.json#/$defs/current_authorization_state"},
    "g24": {"$ref": "common.json#/$defs/g24_lifecycle"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion-ocm.local/schema/g2/method_record_v1.json",
  "title": "MethodRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method_id",
    "payload_sha256",
    "method_schema_id",
    "source_schema",
    "acquisition_lineage",
    "correctness",
    "usefulness",
    "authorization",
    "notes"
  ],
  "properties": {
    "schema": {"type": "string", "const": "ocm.g2.method-record.v1"},
    "method_id": {"$ref": "common.json#/$defs/nonempty_string"},
    "payload_sha256": {"$ref": "common.json#/$defs/unknownable_id"},
    "method_schema_id": {"$ref": "common.json#/$defs/unknownable_id"},
    "source_schema": {"$ref": "common.json#/$defs/unknownable_id"},
    "acquisition_lineage": {"$ref": "common.json#/$defs/acquisition_lineage"},
    "correctness": {"$ref": "common.json#/$defs/correctness_evidence"},
    "usefulness": {"$ref": "common.json#/$defs/usefulness_evidence"},
    "authorization": {"$ref": "common.json#/$defs/current_authorization_state"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

 "claim_ceiling": "exact charged replay at scope; one declared truth model per cell; angles restricted to a declared 12-point grid, so every fit is a grid fit and no continuous optimum is claimed; the n = 2 state is declared rather than searched; native prices are declared, not measured; the QQ census is over declared finite parameter grids (12^3 projective members, 5^6 ordered-Bayes members), not over the continuum",
 "declared_prices": {
  "native": "one op per PROJECT (Lueders projector application) and one per Born readout",
  "reduced": "exact classical state-vector simulation: d = 2^n amplitudes, d^2 = 4^n charged scalar MUL/ADD per dense operator application; QPROJ compiles its projector matrices from the stored angles at COMPILE time (charged into learn_ops) and serves one entry with 2 projector applications + 1 Born readout"
 },
 "description_accounting": {
  "BAYES_ORDERED": "Q*6*PROB_BITS",

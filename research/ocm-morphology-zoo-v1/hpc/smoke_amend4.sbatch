#!/usr/bin/env bash
#SBATCH -J zoo-smoke-a4
#SBATCH -A lu2026-2-51
#SBATCH -p lu48
#SBATCH --qos=test
#SBATCH -t 00:20:00
#SBATCH -c 2
#SBATCH -o logs/smoke_a4_%j.out
#SBATCH -e logs/smoke_a4_%j.err
# Amend-4 execution-host gate: full test suite + amendment sha chain +
# HZD9-truth/P00C binding (xchecks true, quality bar bound into A4, island
# priors in A4 == search.island_qd verbatim, census denominators) + T2 smoke
# of BOTH island arms THROUGH THE SAME WORKER the production array runs
# (ZOO_SMOKE=1 writes SMOKE_QDA4_* only) + one MZ-D9 recompute smoke against
# a smoke amend-3 archive regenerated by the identical map_elites call
# (exercises the determinism-xcheck path end to end).
source "${SLURM_SUBMIT_DIR}/hpc/common_env.sh"
set -euo pipefail
cd "$ZOO_ROOT"
echo "== pytest =="
$ZOO_PY -m pytest tests/ -q
echo "== amendment A4 + HZD9/P00C binding invariants =="
$ZOO_PY - "$ZOO_ROOT" <<'PY'
import hashlib, json, sys
root = sys.argv[1]
a4 = json.load(open(root + "/FREEZE_V1_AMEND_4.json"))
shas = {fn: hashlib.sha256(open(root + "/" + fn, "rb").read()).hexdigest()
        for fn in ("FREEZE_V1.json", "FREEZE_V1_AMEND_1.json",
                   "FREEZE_V1_AMEND_2.json", "FREEZE_V1_AMEND_3.json")}
assert shas["FREEZE_V1.json"] == a4["freeze_v1_sha256"], "freeze chain broken"
assert shas["FREEZE_V1_AMEND_1.json"] == a4["amend_1_sha256"], "amend-1 chain"
assert shas["FREEZE_V1_AMEND_2.json"] == a4["amend_2_sha256"], "amend-2 chain"
assert shas["FREEZE_V1_AMEND_3.json"] == a4["amend_3_sha256"], "amend-3 chain"
assert "freeze_amend4.py" in a4["created_utc_by"], \
    "created_utc not tool-stamped (the amend-3 erratum pattern)"
hz = json.load(open(root + "/archives/HZD9_TRUTH.json"))["summary"]
for k, v in hz["xcheck_vs_P00C"].items():
    if isinstance(v, bool):
        assert v is True, "HZD9 xcheck %s false" % k
assert a4["quality_bar_T2"] == hz["quality_bar_T2"], "quality bar drift"
sys.path.insert(0, root)
from search.island_qd import ISLAND_PRIORS_V1, N_ISLANDS
assert a4["island_priors_amend4"]["n_islands"] == N_ISLANDS == 7
frozen = a4["island_priors_amend4"]["priors"]
assert len(frozen) == N_ISLANDS
from morphology.direct_genome import CENSUS_BOUND_V1  # noqa: E402
for f, p in zip(frozen, ISLAND_PRIORS_V1):
    assert f["island_id"] == p["island_id"] and f["p13_prior"] == p["p13_prior"]
    for fld in ("F_arch", "extras_pool", "extras_required", "n_extras",
                "T_family", "Pi_arch", "L", "R", "K"):
        if p[fld] is None:
            continue  # inherits CENSUS_BOUND_V1 (region-locked fields matter)
        want = (tuple(CENSUS_BOUND_V1[fld]) if p[fld] == "__inherit__"
                else tuple(p[fld]))
        got = tuple(f[fld]) if isinstance(f[fld], list) else f[fld]
        assert got == want, (f["island_id"], fld, got, want)
from evaluation.descriptors import DESCRIPTOR_REGISTRY
from evaluation.objectives import W2_REF, B2_REF
truth = json.load(open(root + "/archives/CENSUS_P00C_TRUTH.json"))["summary"]
for view in ("D_dev_2d", "D_dev_3d"):
    reg = DESCRIPTOR_REGISTRY[view]["bounds"]
    frozen_b = tuple(tuple(b) for b in truth["frozen_grid_bounds"][view])
    assert tuple(tuple(b) for b in reg) == frozen_b, view + " bounds drift"
assert (W2_REF, B2_REF) == (truth["t2_scalar_refs"]["W2_REF"],
                            truth["t2_scalar_refs"]["B2_REF"]), "T2 refs drift"
den, tden = a4["census_truth_P00C"]["denominators"], truth["denominators"]
assert den["PARETO_T2"] == truth["pareto_set_size"] == 792
assert den["D2d@10_occupied"] == tden["D2d@10_occupied"] == 50
assert den["D3d@10_occupied"] == tden["D3d@10_occupied"] == 83
assert den["CVTD_occupied_niches"] == tden["CVTD_occupied_niches"] == 64
tb = json.load(open(root + "/archives/CENSUS_P00B_TRUTH.json"))["summary"]
assert den["S3d@10_occupied_T0ref"] == tb["denominators"]["S3d@10_occupied"] == 8
a3 = json.load(open(root + "/FREEZE_V1_AMEND_3.json"))
assert den == a3["census_truth_P00C"]["denominators"], \
    "amend-4 denominators must equal the amend-3 frozen set"
# production (non-SMOKE) branches of the workers — the ternary smoke cannot
# reach these, so the keys are bound here explicitly (the interval key once
# lived in the wrong block and only the production path caught it)
assert a4["arms_amend4"]["budget"] == 40000
assert a4["island_priors_amend4"]["migration_interval_rounds"] == 500
print("AMEND4 INVARIANTS OK")
PY
echo "== T2 smoke: both island arms through the production worker =="
for a in I01_islands_ring_mig I02_islands_nomig; do
  ZOO_SMOKE=1 $ZOO_PY hpc/qd_run_amend4.py "$ZOO_ROOT" "$a" 0 > /dev/null
  test "$(cut -d' ' -f1 results/SMOKE_QDA4_${a}_s0.status)" = "ok"
  echo "smoke ok: $a"
done
echo "== T2 smoke: one MZ-D9 recompute (P05) through the production worker =="
ZOO_SMOKE=1 $ZOO_PY hpc/qd_run_amend3.py "$ZOO_ROOT" P05_map_elites_D2d 0 > /dev/null
test "$(cut -d' ' -f1 results/SMOKE_QDA3_P05_map_elites_D2d_s0.status)" = "ok"
ZOO_TIER=T2 $ZOO_PY - "$ZOO_ROOT" <<'PY'
import json, os, sys
root = sys.argv[1]
sys.path.insert(0, root)
os.environ["ZOO_TIER"] = "T2"
from search.map_elites import run  # amend-3 smoke used map_elites P05 D_dev_2d
res = run(budget=100, seed=0, archive="D_dev_2d", res=10)
with open(root + "/archives/SMOKE_QDA3_P05_map_elites_D2d_s0_archive.json", "w") as f:
    json.dump(res["archive"], f)
print("smoke archive regenerated: %d elites" % len(res["archive"]))
PY
ZOO_SMOKE=1 $ZOO_PY hpc/hzd9_recompute.py "$ZOO_ROOT" P05_map_elites_D2d 0 > /dev/null
test "$(cut -d' ' -f1 results/SMOKE_HZD9R_P05_map_elites_D2d_s0.status)" = "ok"
echo "smoke ok: hzd9r P05 (determinism xchecks passed)"
echo "SMOKE OK"
